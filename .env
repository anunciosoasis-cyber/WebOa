# ===========================================
# OASIS Frontend - Environment Variables
# ===========================================
# Copy this file to .env.local and configure values

# Backend API URL (REQUIRED for production)

VITE_API_URL=https://oasis-backend-latest.onrender.com
VITE_FASTAPI_URL=https://oasisbackend-fastapi.onrender.com/api/v1
# Note: For Vercel deployment, set this in Vercel Dashboard:
# Project Settings > Environment Variables > Add VITE_API_URL
