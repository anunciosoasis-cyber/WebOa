# ===========================================
# OASIS Frontend - Environment Variables
# ===========================================
# Copy this file to .env.local and configure values

# Backend API URL (REQUIRED)
# Development: http://localhost:3000
# Producción con docker compose: lo pone el compose (PUBLIC_URL)
VITE_API_URL=http://localhost:3000

# Botón "Continuar con Google" (client ID web). Vacío = sin botón
VITE_GOOGLE_CLIENT_ID=

# API de Biblia e Himnario (AdventistMediaEngine, MEDIA_MODE=online). Desarrollo: motor local en :5001
VITE_MEDIA_API_URL=http://localhost:5001
